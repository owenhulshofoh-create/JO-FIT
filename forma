function miniLineSVG(points,label){if(!points.length)return '';const w=350,h=150,min=Math.min(...points.map(x=>x.value)),max=Math.max(...points.map(x=>x.value)),span=Math.max(1,max-min),x=i=>18+i*(w-36)/Math.max(1,points.length-1),y=v=>h-20-(v-min)/span*(h-42),path=points.map((p,i)=>`${i?'L':'M'}${x(i)},${y(p.value)}`).join(' ');return `<svg class="f3-chart" viewBox="0 0 ${w} ${h}" role="img" aria-label="${safe(label)} door de tijd"><path d="${path}" stroke="#fc6378" stroke-width="3.5" fill="none" stroke-linecap="round"/>${points.map((p,i)=>`<circle cx="${x(i)}" cy="${y(p.value)}" r="4.5" fill="#ffaab5"><title>${safe(p.date)}: ${nfmt(p.value,1)}</title></circle>`).join('')}</svg>`;}
