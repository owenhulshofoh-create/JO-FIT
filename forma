document.getElementById('view').addEventListener('click',function(event){
 const button=event.target.closest('[data-forma-go]');
 if(button)switchTab(button.dataset.formaGo);
});

if(window.matchMedia('(prefers-reduced-motion: reduce)').matches)animRunning=false;
renderView();
