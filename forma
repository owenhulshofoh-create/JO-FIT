const MUS={chest:'Borst',triceps:'Triceps',shoulders:'Schouders',frontdelts:'Voorste schouder',sidedelts:'Zijkant schouder',reardelts:'Achterste schouder',lats:'Brede rugspier',midback:'Middenrug',traps:'Trapezius',biceps:'Biceps',forearms:'Onderarmen',abs:'Buikspieren',obliques:'Schuine buikspieren',quads:'Quadriceps',hamstrings:'Hamstrings',glutes:'Bilspieren',calves:'Kuiten',lowerback:'Onderrug'};
const GROUPS=['Alles','Borst','Rug','Schouders','Armen','Benen','Buik'];
