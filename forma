function renderRecovery(){const day=todayISO(),today=extras.recovery.find(x=>x.date===day),recent=extras.recovery.slice().sort((a,b)=>b.date.localeCompare(a.date)).slice(0,12);$('#view').innerHTML=`<section class="section-top"><div><h2>Herstelmonitor</h2><p>Monitor slaap, spierpijn, energie en herstelgevoel; dit zijn zelfrapportages, geen medische metingen.</p></div></section><div class="f3-cols"><section class="f3-card"><h3>Dagelijkse check-in</h3><form id="recoveryForm" class="f3-form"><label>Datum<input type="date" name="date" value="${day}" required></label><div class="f3-fields"><label>Slaap (uren)<input type="number" name="sleep" min="0" max="16" step="0.25" value="${today?.sleep??7.5}" required></label><label>Spierpijn (0–10)<input type="number" name="soreness" min="0" max="10" value="${today?.soreness??2}" required></label></div><div class="f3-fields"><label>Vermoeidheid (0–10)<input type="number" name="fatigue" min="0" max="10" value="${today?.fatigue??3}" required></label><label>Motivatie (0–10)<input type="number" name="motivation" min="0" max="10" value="${today?.motivation??8}" required></label></div><label>Notitie<textarea name="note" maxlength="280" rows="3" placeholder="Bijv. zwaar voetbalweekend, achilles gevoelig…">${safe(today?.note||'')}</textarea></label><button class="savebutton">Check-in opslaan</button></form></section><section class="f3-card"><h3>Hersteladvies</h3>${today?`<div class="f3-score"><span>Indicatieve herstelindicator</span><b>${Math.max(0,Math.min(100,recoveryScore(today)))}/100</b></div><p>${recoveryScore(today)>=70?'Je geeft relatief goede herstelwaarden aan. Train normaal, maar stuur bij als je techniek of energie tegenvalt.':recoveryScore(today)>=45?'Je voelt je mogelijk niet optimaal hersteld. Begin rustig en pas belasting of sets aan waar nodig.':'Je rapporteert weinig slaap of veel vermoeidheid/spierpijn. Overweeg een lichtere training of extra herstel.'}</p>`:'<p class="f3-muted">Voeg je eerste check-in toe om een indicat