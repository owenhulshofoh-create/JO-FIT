function renderBody(){const items=extras.measurements.slice().sort((a,b)=>b.date.localeCompare(a.date));const latest=items[0]||{};$('#view').innerHTML=`<section class="section-top"><div><h2>Lichaam & metingen</h2><p>Gewicht, omvang en voortgangsfoto's — alleen opgeslagen in dit profiel op dit apparaat.</p></div></section><div class="f3-cols"><section class="f3-card"><h3>Nieuwe meting</h3><form id="measureForm" class="f3-form"><label>Datum<input name="date" type="date" value="${todayISO()}" required></label><div class="f3-fields"><label>Gewicht (kg)<input name="weight" type="number" min="20" max="350" step="0.1" placeholder="105"></label><label>Taille (cm)<input name="waist" type="number" min="30" max="250" step="0.1" placeholder="104"></label></div><div class="f3-fields"><label>Borst (cm)<input name="chest" type="number" min="30" max="250" step="0.1"></label><label>Arm (cm)<input name="arm" type="number" min="10" max="100" step="0.1"></label></div><button class="savebutton" type="submit">+ Meting opslaan</button></form></section><section class="f3-card"><h3>Jouw ontwikkeling</h3><div class="f3-fields"><div class="f3-result"><small>Laatste gewicht</small><h2>${latest.weight?nfmt(latest.weight,1)+' kg':'—'}</h2></div><div class="f3-result"><small>Laatste taille</small><h2>${latest.waist?nfmt(latest.waist,1)+' cm':'—'}</h2></div></div>${items.length>1?miniLineSVG(items.filter(x=>x.weight).slice().reverse().map(x=>({date:x.date,value:x.weight})), 'Gewicht (kg)'):'<p class="f3-muted">Na meerdere metingen verschijnt hier een gewichtsverloop.</p>'}<div class="f3-list">${items.slice(0,12).map(x=>`<div><span>${safe(x.date)}</span><b>${x.weight?nfmt(x.weight,1)+' kg':'—'} · ${x.waist?nfmt(x.waist,1)+' cm':'—'}</b><button class="f3-iconbtn" data-del-meas="${safe(x.id)}">×</button></div>`).join('')}</div></section></div><section class="f3-card"><h3>Voortgangsfoto's</h3><p class="f3-muted">Bewaar je foto's lokaal. Maximaal 12 gecomprimeerde foto's per profiel. Exporteer regelmat