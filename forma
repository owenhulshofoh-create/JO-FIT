 const section=FORMA_ACTIVE_TEXTS.sections[tab]||{},info={...FORMA_VISUALS[tab],...section};
 const gallery=document.getElementById('formaFeatureNav');if(gallery)gallery.hidden=tab!=='schema';
 if(!info||info.enabled===false)return;
 const banner=document.createElement('section');
 banner.className='forma-visual-strip';
 banner.setAttribute('aria-label','Fitness en '+tab);
 banner.innerHTML=`<div class="forma-strip-info">${info.eyebrow?`<span class="forma-strip-overline">${safe(info.eyebrow)}</span>`:''}${info.headline?`<h3>${safe(info.headline)}</h3>`:''}${info.subtitle?`<p>${safe(info.subtitle)}</p>`:''}<button type="button" class="forma-strip-cta" data-forma-go="${safe(info.action)}">${safe(info.button)}</button></div><div class="forma-strip-art"><img src="${safe(formaAssetUrl(info.image))}" alt="Fitnessafbeelding bij ${safe(tab)}" loading="lazy" decoding="async"></div>`;
 const heading=view.querySelector(':scope > .section-top');
 if(heading)heading.after(banner);else view.prepend(banner);
}
const formaArtObserver=new MutationObserver(()=>formaDecorateView());
formaArtObserver.observe(document.getElementById('view'),{childList:true});
