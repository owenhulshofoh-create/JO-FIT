function friendInviteCode(){return btoa(unescape(encodeURIComponent(JSON.stringify(myFriendSnapshot()))));}
function friendshipMessage(){const d=myFriendSnapshot();return `🏋️ Forma Fitnesscoach 3.0\n${d.name}: ${d.weekSessions} trainingen en ${d.weekSets} sets deze week. Totaal ${d.totalSessions} trainingen.\n\nVriendencode: ${friendInviteCode()}\n\n${location.protocol.startsWith('http')?location.origin+location.pathname:''}`;}
function renderFriends(){const mine=myFriendSnapshot();const configured=cloudConfigured();$('#view').innerHTML=`<section class="section-top"><div><h2>Vrienden & accounts</h2><p>Train samen en bewaar je persoonlijke voortgang apart.</p></div></section><div class="f3-cols"><section class="f3-card"><div class="forma-friends-invite"><div><strong>🎯 Nodig iemand uit voor Forma</strong><p>Iedereen begint op zijn eigen telefoon met een eigen trainingslogboek en kan het schema zelf aanpassen.</p></div><button type="button" class="savebutton" id="formaInviteFriend">↗ Deel de app-link</button></div><h3>Jouw vriendenkaart</h3><div class="f3-friendcard"><strong>${safe(mine.name)}</strong><div><b>${mine.weekSessions}</b><span>Trainingen deze week</span></div><div><b>${mine.weekSets}</b><span>Sets deze week</span></div><div><b>${mine.totalSessions}</b><span>Totaal opgeslagen</span></div></div><div class="f3-fields"><button id="friendShare" class="savebutton">Deel via WhatsApp / kopieer</button><button id="friendCopy" class="f3-small">Kopieer vriendenkaart-code</button></div><p class="f3-note">Deel alleen je trainingsstatistieken. Foto’s, herstelnotities en voedingsgegevens worden niet meegestuurd.</p><h4>Vriend toevoegen met code</h4><form id="friendAddForm" class="f3-form"><textarea id="friendInput" rows="3" placeholder="Plak de vriendenkaart-code van je trainingsmaat" required></textarea><button class="f3-small">Voeg deze update toe</button></form></section><section class="f3-card"><h3>Mijn vrienden</h3>${extras.friends.length?extras.friends.map(x=>`<div class="f3-friendcard f3-friend-sm"><strong>${safe(x.name)}</strong><div><b>${x.weekSessions}</b><span>Trainingen</span></div><div><b>${x.weekSets}</b><span>Werksets</span></div><div><small>Bijgewerkt: ${safe(x.date)}</small></div><button class="f3-small" data-del-friend="${safe(x.name)}">Verwijder</button></div>`).join(''):'<p class="f3-muted">Nog geen vriendenkaarten toegevoegd. Deel de code en vraag je kameraad zijn code terug te sturen.</p>'}<p class="f3-note">Vriendenvergelijking werkt via handmatig gedeelde updates. Dit is geen automatisch live volgsysteem.</p></section></div>
 <section class="f3-card"><div class="f3-cardhead"><h3>Persoonlijk cloudaccount</h3><small>${configured?'Project ingesteld — aanmelden of synchroniseren':'Optionele Supabase-koppeling vereist'}</small></div><p>Je kunt de app zonder account gebruiken: ieder heeft dan eigen gegevens op zijn eigen toestel. Voor een echte persoonlijke cloudlogin op meerdere apparaten moet de beheerder een Supabase-project met beveiligde tabel inrichten.</p><div class="f3-cloud-status" id="cloudStatus">${cloudUser?.email?`Ingelogd als ${safe(cloudUser.email)} (nog niet automatisch gesynchroniseerd)`:'Niet aangemeld bij een cloudaccount.'}</div><details><summary>Cloudproject instellen (beheerder)</summary><p class="f3-note">Voer uitsluitend de publieke project-URL en publishable/anon-key in. Gebruik nooit een service-role of geheime API-sleutel in de browser. Pas eerst het SQL-script in het ZIP-pakket toe.</p><div class="f3-fields"><label>Supabase-project-URL<input id="cloudURL" type="url" placeholder="https://project.supabase.co" value="${safe(cloudPrefs.url||'')}"></label><label>Publishable / anon key<input id="cloudKey" type="text" placeholder="sb_publishable_… of anon key" value="${safe(cloudPrefs.anonKey||'')}"></label></div><button id="cloudSet" class="f3-small">Projectinstellingen bewaren</button></details><form id="cloudLoginForm" class="f3-form"><div class="f3-fields"><label>E-mail<input name="email" type="email" autocomplete="email" required></label><label>Wachtwoord<input name="password" type="password" autocomplete="current-password" minlength="6" required></label></div><div class="f3-fields"><button type="button" class="f3-small" id="cloudSignup">Account aanmaken</button><button type="submit" class="savebutton">Inloggen</button></div></form><div class="f3-fields"><button class="f3-small" id="cloudPull" ${cloudUser?'':'disabled'}>Mijn cloudgegevens ophalen</button><button class="f3-small" id="cloudPush" ${cloudUser?'':'disabled'}>Dit profiel uploaden</button><button class="f3-small" id="cloudLogout" ${cloudUser?'':'disabled'}>Uitloggen</button></div><p class="f3-note">Synchronisatie is voorlopig handmatig: kies ophalen of uploaden. Opvragen vervangt de gegevens van dit profiel; maak vooraf een back-up. Je accountgegevens worden niet aan je vrienden getoond.</p></section>`;
 $('#formaInviteFriend').onclick=shareApp;$('#friendShare').onclick=async()=>{const msg=friendshipMessage();try{if(navigator.share)await navigator.share({text:msg,title:'Forma Fitnesscoach — voortgang'});else if(navigator.clipboard)await navigator.clipboard.writeText(msg);else prompt('Kopieer:',msg);toast('Vriendenkaart gedeeld/gekopieerd');}catch(err){if(err.name!=='AbortError')toast('Delen niet gelukt');}};$('#friendCopy').onclick=async()=>{const s=friendInviteCode();try{if(navigator.clipboard)await navigator.clipboard.writeText(s);else prompt('Kopieer:',s);toast('Code gekopieerd');}catch(err){prompt('Kopieer:',s);}};$('#friendAddForm').onsubmit=e=>{e.preventDefault();try{const raw=$('#friendInput').value.trim().split('Vriendencode:').at(-1).trim().split(/\s/)[0];const x=JSON.parse(decodeURIComponent(escape(atob(raw))));if(x.formaFriend!==1||!x.name||!Number.isFinite(Number(x.weekSets)))throw Error('Geen geldige Forma-vriendenkaart');const f={name:String(x.name).slice(0,40),date:String(x.date).slice(0,10),weekSessions:Math.max(0,Math.round(Number(x.weekSessions))),weekSets:Math.max(0,Math.round(Number(x.weekSets))),totalSessions:Math.max(0,Math.round(Number(x.totalSessions)))};extras.friends=extras.friends.filter(y=>y.name!==f.name);extras.friends.push(f);persist();renderFriends();toast('Vriend toegevoegd');}catch(err){toast('Deze code is ongeldig of onvolledig');}};$$('[data-del-friend]').forEach(b=>b.onclick=()=>{extras.friends=extras.friends.filter(x=>x.name!==b.dataset.delFriend);persist();renderFriends();});$('#cloudSet').onclick=()=>{const url=$('#cloudURL').value.trim().replace(/\/$/,''),key=$('#cloudKey').value.trim();if(url&&!/^https:\/\/[a-z0-9-]+\.supabase\.co$/i.test(url))return toast('Gebruik de https-project-URL van Supabase');cloudPrefs={url,anonKey:key};localStorage.setItem('forma3_cloud_prefs',JSON.stringify(cloudPrefs));renderFriends();toast('Cloudproject ingesteld');};$('#cloudLoginForm').onsubmit=e=>{e.preventDefault();cloudLogin(false)};$('#cloudSignup').onclick=()=>cloudLogin(true);$('#cloudLogout').onclick=()=>{cloudUser=null;sessionStorage.removeItem('forma3_cloud_session');renderFriends();toast('Cloudaccount afgemeld')};$('#cloudPush').onclick=cloudPush;$('#cloudPull').onclick=cloudPull;}
let cloudPrefs=readJson('forma3_cloud_prefs')||{url:'',anonKey:''},cloudUser=(()=>{try{return JSON.parse(sessionStorage.getItem('forma3_cloud_session')||'null')}catch{return null}})();
function cloudConfigured(){return /^https:\/\/[a-z0-9-]+\.supabase\.co$/i.test(cloudPrefs.url||'')&&String(cloudPrefs.anonKey||'').length>10;}
function cloudMessage(msg){const el=$('#cloudStatus');if(el)el.textContent=msg;toast(msg.slice(0,95));}
async function cloudLogin(signup){if(!cloudConfigured())return cloudMessage('Configureer eerst het cloudproject met URL en publieke sleutel.');const f=new FormData($('#cloudLoginForm')),email=String(f.get('email')).trim(),password=String(f.get('password'));if(!email||password.length<6)return cloudMessage('Vul e-mail en minimaal 6 tekens wachtwoord in.');cloudMessage('Verbinding maken…');try{const route=signup?'signup':'token?grant_type=password',res=await fetch(`${cloudPrefs.url}/auth/v1/${route}`,{method:'POST',headers:{'apikey':cloudPrefs.anonKey,'Content-Type':'application/json'},body:JSON.stringify({email,password})}),x=await res.json();if(!res.ok)throw Error(x.msg||x.error_description||x.message||'Inloggen mislukt');if(!x.access_token){cloudMessage('Account aangevraagd. Bevestig eerst je e-mailadres via de ontvangen e-mail.');return;}cloudUser={access_token:x.access_token,user_id:x.user?.id,email:x.user?.email};sessionStorage.setItem('forma3_cloud_session',JSON.stringify(cloudUser));renderFriends();cloudMessage('Ingelogd. Kies ophalen op je tweede apparaat of uploaden na je eerste login.');}catch(err){cloudMessage(err.message||'Kon niet inloggen');}}
function cloudHeaders(){return {'apikey':cloudPrefs.anonKey,'Authorization':'Bearer '+cloudUser.access_token,'Content-Type':'application/json'};}
async function cloudPush(){if(!cloudConfigured()||!cloudUser?.user_id)return cloudMessage('Log eerst in bij je eigen account.');persist();const data=allProfiles.profiles[activeProfile],payload={user_id:cloudUser.user_id,data:{...data,extras:{...data.extras,photos:(data.extras?.photos||[])}}};if(JSON.stringify(payload).length>2e6)return cloudMessage('Je profiel is te groot voor deze upload. Verwijder enkele foto’s of maak een back-up.');try{cloudMessage('Uploaden…');const res=await fetch(`${cloudPrefs.url}/rest/v1/forma_user_data?on_conflict=user_id`,{method:'POST',headers:{...cloudHeaders(),'Prefer':'resolution=merge-duplicates,return=minimal'},body:JSON.stringify(payload)});if(!res.ok)throw Error((await res.text()).slice(0,130));cloudMessage('Persoonlijke cloudgegevens veilig opgeslagen.');}catch(err){cloudMessage('Upload mislukt: '+(err.message||err));}}
async function cloudPull(){if(!cloudConfigured()||!cloudUser?.user_id)return cloudMessage('Log eerst in bij je eigen account.');if(!confirm('Je lokale actieve profiel wordt vervangen door de cloudversie. Maak zo nodig eerst een back-up. Doorgaan?'))return;try{cloudMessage('Ophalen…');const res=await fetch(`${cloudPrefs.url}/rest/v1/forma_user_data?user_id=eq.${encodeURIComponent(cloudUser.user_id)}&select=data`,{headers:cloudHeaders()});if(!res.ok)throw Error((await res.text()).slice(0,130));const rows=await res.json(),p=rows[0]?.data;if(!p?.routines||!p.routines[p.activeRoutine])throw Error('Nog geen online profiel. Kies eerst uploaden.');allProfiles.profiles[activeProfile]={...p,name:String(p.name||'Mijn training').slice(0,40)};loadProfile();persist();updateProfileUI();renderFriends();cloudMessage('Cloudgegevens opgehaald voor dit profiel.');}catch(err){cloudMessage('Ophalen mislukt: '+(err.message||err));}}
function beginRest(duration){if(restTimerId)clearInterval(restTimerId);restEnds=Date.now()+Math.max(10,Number(duration||extras.settings.rest))*1000;restPaused=0;restTimerId=setInterval(updateRestUI,250);updateRestUI();}
let restEnds=0,restPaused=0,restTimerId=0;
function timerRemaining(){return restPaused||Math.max(0,Math.ceil((restEnds-Date.now())/1000));}
function updateRestUI(){const el=$('#f3timer');if(!el)return;const rem=timerRemaining(),time=el.querySelector('#f3time');if(time)time.textContent=`${String(Math.floor(rem/60)).padStart(2,'0')}:${String(rem%60).padStart(2,'0')}`;if(rem<=0&&restEnds&&!restPaused){clearInterval(restTimerId);restEnds=0;el.classList.add('completed');try{if(navigator.vibrate)navigator.vibrate([100,70,100]);}catch{}}else el.classList.remove('completed');}
function stopRest(){restEnds=0;restPaused=0;clearInterval(restTimerId);updateRestUI();}
function pauseRest(){if(restPaused){restEnds=Date.now()+restPaused*1000;restPaused=0;restTimerId=setInterval(updateRestUI,250);}else if(restEnds){restPaused=timerRemaining();restEnds=0;clearInterval(restTimerId);}updateRestUI();}
function setupTimer(){const host=document.createElement('div');host.id='f3timer';host.className='f3-timer';host.innerHTML='<button type="button" id="f3expand" class="f3-timer-label" aria-expanded="false">⏱ Rust <b id="f3time">00:00</b> ▴</button><div class="f3-timer-controls" id="f3controls" hidden><select id="f3duration" aria-label="Rustduur"><option value="auto" selected>Auto per oefening</option><option value="60">60 sec</option><option value="90">90 sec</option><option value="120">120 sec</option><option value="180">180 sec</option></select><button id="f3start" type="button">Start</button><button id="f3pause" type="button">Pauze</button><button id="f3stop" type="button">Stop</button></div>';document.body.appendChild(host);$('#f3expand').onclick=()=>{const box=$('#f3controls');box.hidden=!box.hidden;$('#f3expand').setAttribute('aria-expanded',String(!box.hidden));};$('#f3start').onclick=()=>beginRest($('#f3duration').value==='auto'?extras.settings.rest:Number($('#f3duration').value));$('#f3pause').onclick=pauseRest;$('#f3stop').onclick=stopRest;}
function onCompletedSet(exerciseId){const selection=$('#f3duration')?.value||'auto';const duration=selection==='auto'?(EX[exerciseId]?.rest||extras.settings.rest):Number(selection);beginRest(duration);}

setupTimer();
function formaWelcomeOnce(){if(!formaIsFirstVisit||sessionStorage.getItem('forma_welcome_dismissed'))return;const root=document.createElement('div');root.className='forma-share-backdrop';root.innerHTML=`<section class="forma-share-dialog forma-welcome" role="dialog" aria-modal="true" aria-label="Welkom bij Forma"><button class="forma-share-close" aria-label="Sluiten">×</button><div class="forma-share-emblem">💪</div><h2>Welkom bij Forma!</h2><p>Dit is jouw persoonlijke fitnesscoach. Je trainingen en metingen blijven op <strong>dit apparaat</strong> en worden niet met andere bezoekers gedeeld.</p><label class="forma-welcome-field">Hoe mogen we je profiel noemen?<input id="formaWelcomeName" maxlength="38" placeholder="Bijvoorbeeld: Mijn training" autocomplete="nickname"></label><label class="forma-welcome-check"><input type="checkbox" id="formaWelcomeBlank"> Ik begin liever met een leeg schema</label><button class="savebutton" id="formaWelcomeStart">Start mijn eigen Forma</button><p class="forma-share-sub">Je kunt altijd via + Profiel een tweede profiel aanmaken en via Back-up je gegevens downloaden.</p></section>`;document.body.appendChild(root);const close=()=>{sessionStorage.setItem('forma_welcome_dismissed','1');root.remove();};root.querySelector('.forma-share-close').onclick=close;root.onclick=e=>{if(e.target===root)close();};root.querySelector('#formaWelcomeStart').onclick=()=>{const name=root.querySelector('#formaWelcomeName').value.trim().slice(0,38);if(name)allProfiles.profiles[activeProfile].name=name;if(root.querySelector('#formaWelcomeBlank').checked){const empty=Object.fromEntries(keys.map(day=>[day,[]]));routines[activeRoutine].schedule=empty;schedule=empty;}persist();updateProfileUI();renderView();close();toast('Je eigen Forma-profiel is klaar!');};}

formaWelcomeOnce();
</script></body></html>
