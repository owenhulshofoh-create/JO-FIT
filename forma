function recordsFor(id){const rows=sessions.flatMap(s=>(s.exercises||[]).filter(x=>x.id===id).map(x=>({...x,date:s.date}))).filter(x=>x.kg!==''&&Number.isFinite(Number(x.kg)));if(!rows.length)return null;return {bestKg:Math.max(...rows.map(x=>Number(x.kg))),bestEst:Math.max(...rows.map(x=>Number(x.kg)*(1+Math.min(30,upperReps(x.reps))/30))),count:rows.length,last:rows.at(-1)};}
function getRpeValue(obj){if(obj==null)return'';if(typeof obj!=='object')return'';if(obj.rpe!==undefined&&obj.rpe!==null&&obj.rpe!==''){const v=Number(obj.rpe);return Number.isFinite(v)?v:'';}if(obj.rir!==undefined&&obj.rir!==null&&obj.rir!==''){const v=10-Number(obj.rir);return Number.isFinite(v)?v:'';}return'';}
function getRirValue(obj){if(obj==null)return'';if(typeof obj!=='object')return'';if(obj.rir!==undefined&&obj.rir!==null&&obj.rir!==''){const v=Number(obj.rir);return Number.isFinite(v)?v:'';}if(obj.rpe!==undefined&&obj.rpe!==null&&obj.rpe!==''){const v=10-Number(obj.rpe);return Number.isFinite(v)?v:'';}return'';}
function rpeOptions(selected){const cur=selected===''||selected==null?'':String(selected);let out=`<option value="">—</option>`;for(let i=1;i<=10;i++)out+=`<option value="${i}" ${cur===String(i)?'selected':''}>${i}</option>`;return out;}
function effortIndicator(entry){const rpe=getRpeValue(typeof entry==='object'?entry:{rir:entry});if(rpe===''||rpe==null)return'Niet ingevuld';return `RPE ${nfmt(rpe,1)} · RIR ±${nfmt(10-Number(rpe),1)}`;}
