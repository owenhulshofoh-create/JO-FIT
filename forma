function add(id,name,group,motion,primary,secondary,equipment,steps,avoid,setup){EX[id]={id,name,group,motion,primary:primary.split(' '),secondary:secondary?secondary.split(' '):[],equipment,steps,avoid,setup:setup||'',rest:group==='Benen'?90:75};}
// Alle 26 unieke oefeningen van de ingezonden screenshots
add('incline-press','Incline Dumbbell Press','Borst','inclinePress','chest frontdelts','triceps','Dumbbells + schuine bank',['Zet de bank op circa 20–35 graden. Voeten stevig op de grond.','Laat beide dumbbells gecontroleerd zakken naast de bovenkant van je borst.','Druk omhoog tot boven je borst, zonder je ellebogen hard te vergrendelen.'],'Holle onderrug, te steile bank of gewicht tegen elkaar slaan.');
add('crossbody-triceps','Single-Arm Cable Crossbody Triceps Extension','Armen','crossbody','triceps','','Kabelstation',['Zet de katrol ongeveer op schouderhoogte en pak de greep met één hand.','Houd je bovenarm dicht bij je lichaam; strek je elleboog schuin over je lichaam.','Keer beheerst terug zonder met je schouder te zwaaien.'],'De bovenarm heen en weer bewegen of je romp meedraaien.');
add('shoulder-press','Seated Dumbbell Shoulder Press','Schouders','shoulderPress','frontdelts sidedelts','triceps','Dumbbells + bank',['Zit stabiel met je rug tegen een licht achteroverhellende leuning.','Start met dumbbells ongeveer ter hoogte van je oren.','Druk opwaarts boven je hoofd en zak rustig naar de startpositie.'],'Onderrug sterk overstreken of schouders optrekken.');
add('triceps-dips','Triceps Dips','Armen','dips','triceps','chest frontdelts','Diprek',['Plaats je handen op het diprek en houd je schouders laag.','Zak met je ellebogen naar achteren zolang dat prettig is voor je schouders.','Duw jezelf weer omhoog door je ellebogen te strekken.'],'Te diep zakken of je schouders naar voren laten vallen.');
add('lat-wide','Lat Pulldown — brede greep','Rug','pulldownWide','lats','biceps midback','Lat pulldown',['Pak de stang iets breder dan schouderbreedte en houd je borst hoog.','Trek je ellebogen naar je zij, met de stang richting bovenborst.','Laat je armen langzaam uitstrekken zonder je romp te laten zwaaien.'],'Stang achter je nek trekken of sterk achterover leunen.');
add('incline-curl','Incline Dumbbell Curl','Armen','inclineCurl','biceps','forearms','Dumbbells + schuine bank',['Ga met je rug tegen een schuine bank zitten en laat je armen hangen.','Houd je ellebogen vrijwel op dezelfde plek terwijl je de dumbbells krult.','Laat gecontroleerd zakken tot je ellebogen weer bijna gestrekt zijn.'],'Met schouders trekken of je polsen knikken.');
add('bentover-row','Barbell Bent-Over Row','Rug','bentRow','midback lats','biceps lowerback','Halterstang',['Kantel vanuit je heupen en houd je rug neutraal.','Trek de stang richting je onderbuik met je ellebogen langs je zij.','Laat de stang rustig zakken zonder je rugpositie te verliezen.'],'Rug bol maken, romp omhoog zwiepen of het gewicht rukken.');
add('face-pull','Cable Face Pull','Schouders','facePull','reardelts midback','traps','Kabel + touw',['Stel de katrol op gezichts- of iets hogere hoogte in.','Trek het touw naar je gezicht en spreid je handen aan weerszijden van je hoofd.','Houd je schouders laag en keer rustig terug.'],'Je nek naar voren duwen of met je onderrug trekken.');
add('inverted-row','Inverted Row','Rug','invertedRow','midback lats','biceps','Stevige stang / rek',['Hang onder een stevige stang met je lichaam in een rechte lijn.','Trek je borst naar de stang door je schouderbladen naar elkaar te bewegen.','Zak gecontroleerd terug.'],'Heupen laten doorhangen of je kin vooruitsteken.');
add('hammer-curl','Hammer Curl','Armen','hammerCurl','biceps forearms','','Dumbbells',['Sta rechtop met de handpalmen naar binnen gericht.','Buig je ellebogen zonder je bovenarmen naar voren te zwaaien.','Laat de dumbbells beheerst zakken.'],'Rompzwaai gebruiken of ellebogen te ver naar voren brengen.');
add('bench-press','Bankdrukken','Borst','benchPress','chest','triceps frontdelts','Halterstang + vlakke bank',['Zet voeten stevig neer, span je bovenrug en houd de schouderbladen stabiel.','Laat de stang gecontroleerd zakken naar je midden- tot onderborst.','Druk omhoog boven je schouders; gebruik een spotter of veiligheidssteunen.'],'Billen van de bank tillen of zonder beveiliging tot volledig falen trainen.');
add('overhead-triceps','Cable Overhead Triceps Extension','Armen','overheadExt','triceps','','Kabel + touw',['Ga met je rug naar het kabelstation staan en houd het touw boven/achter je hoofd.','Houd je bovenarmen zo stabiel mogelijk.','Strek je ellebogen en keer langzaam terug voor een diepe rek.'],'Overmatig hol trekken in de rug of de ellebogen sterk uit elkaar gooien.');
add('pec-deck','Butterfly / Pec Deck','Borst','pecDeck','chest','frontdelts','Pec-deck station',['Stel de stoel zo af dat de armen ongeveer op borsthoogte bewegen.','Beweeg de armen in een boog naar elkaar toe.','Open beheerst tot je een comfortabele rek in je borst voelt.'],'Schouders forceren in een te diepe rek of het gewicht laten terugvallen.');
add('lateral-raise','Dumbbell Lateral Raise','Schouders','lateralRaise','sidedelts','traps','Dumbbells',['Sta rechtop met licht gebogen ellebogen.','Til je bovenarmen zijwaarts ongeveer tot schouderhoogte.','Laat rustig zakken met controle.'],'Schouders optrekken of het gewicht omhoog gooien.');
add('reverse-fly','Dumbbell Reverse Fly','Schouders','reverseFly','reardelts','midback','Dumbbells',['Buig naar voren vanuit je heupen met neutrale rug.','Beweeg je armen in een wijde boog naar buiten, ellebogen licht gebogen.','Pauzeer kort en zak gecontroleerd.'],'Met je romp opveren of schouders hoog optrekken.');
add('triceps-pushdown','Cable Triceps Pushdown','Armen','pushdown','triceps','','Kabelstation',['Houd je ellebogen naast je romp en pak de stang of het touw.','Strek je ellebogen tot je armen vrijwel recht zijn.','Laat de greep langzaam terugkomen zonder je schouders te bewegen.'],'Met het bovenlichaam op de stang drukken of ellebogen naar voren schuiven.');
add('lat-narrow','Lat Pulldown — smalle greep','Rug','pulldownNarrow','lats','biceps midback','Lat pulldown + smalle greep',['Neem een neutrale, smalle greep en houd je borst hoog.','Trek je ellebogen omlaag naast je romp.','Breng de greep gecontroleerd terug naar boven.'],'Te ver achterover leunen of vanuit de armen rukken.');
add('standing-curl','Standing Biceps Curl','Armen','curl','biceps','forearms','Dumbbells of halterstang',['Sta stabiel met je ellebogen dicht bij je zij.','Krul het gewicht omhoog met je biceps.','Laat langzaam en volledig zakken zonder je romp te bewegen.'],'Heupen gebruiken om het gewicht te lanceren.');
add('seated-cable-row','Seated Cable Row','Rug','seatedRow','midback lats','biceps','Kabelroeier',['Zit rechtop met knieën iets gebogen, borst omhoog.','Trek de handgreep richting je onderribben.','Strek je armen weer naar voren zonder je onderrug te bollen.'],'Ver achterover zwaaien of schouders overdreven optrekken.');
add('preacher-curl','Preacher Curl','Armen','preacher','biceps','','Preacher-bank + dumbbell',['Ondersteun je bovenarm volledig op de schuine steun.','Krul de dumbbell omhoog zonder je schouder van de steun te halen.','Laat langzaam zakken; vermijd hard vergrendelen onderin.'],'Onderaan bouncen of je bovenarm optillen.');
add('squat','Barbell Squat','Benen','squat','quads glutes','abs','Halterstang + rack',['Zet voeten ongeveer op schouderbreedte en span romp en bovenrug aan.','Buig knieën en heupen terwijl je gewicht verdeeld blijft over je voeten.','Duw de vloer weg en kom gecontroleerd omhoog.'],'Knieën laten wegvallen of de onderrug rond maken om dieper te komen.');
add('hamstring-curl','Hamstring Curl','Benen','hamstringCurl','hamstrings','','Leg-curl machine',['Stel de machine af zodat je knieën met het draaipunt uitlijnen.','Buig je knieën en breng je hielen naar achteren/omhoog.','Strek langzaam terug zonder je heupen te laten bewegen.'],'Gewicht laten vallen of je heupen van de steun liften.');
add('calf-raise','Standing Calf Raise','Benen','calfRaise','calves','','Gewicht + stabiele verhoging',['Sta met de bal van je voet op een stabiele verhoging.','Kom gecontroleerd hoog op je tenen en pauzeer kort.','Laat je hak langzaam zakken tot een comfortabele rek.'],'Verend bewegen; bij achillesklachten binnen je pijngrens blijven.');
add('cable-crunch','Cable Crunch','Buik','cableCrunch','abs','','Kabel + touw',['Kniel met het touw bij de zijkanten van je hoofd.','Breng je ribben richting je bekken door je wervelkolom gecontroleerd te buigen.','Keer langzaam terug zonder met je armen te trekken.'],'Vooral vanuit de heupen bewegen of het gewicht met je handen trekken.');
add('leg-extension','Leg Extension','Benen','legExtension','quads','','Leg-extension machine',['Lijn je knie uit met het draaipunt van de machine.','Strek beide knieën totdat je benen bijna recht zijn.','Laat beheerst terugzakken.'],'Schokken of geforceerd hard vergrendelen.');
add('weighted-leg-raise','Weighted Leg Raise','Buik','legRaise','abs','obliques','Rek of bank + enkelgewicht',['Hang of steun stabiel aan het rek.','Kantel je bekken achterover en hef je knieën/benen richting borst.','Zak rustig terug zonder te schommelen.'],'Zwaaien of alleen vanuit je heupbuigers trekken.');
// Extra oefeningen om later schema's te wisselen.
add('pullup','Pull-Up','Rug','pullup','lats','biceps midback','Optrekstang',['Begin vanuit een actieve hang met je schouders stabiel.','Trek je ellebogen omlaag en je borst richting de stang.','Laat gecontroleerd terugzakken.'],'Met de benen zwaaien of de nek overstrekken.');
add('chinup','Chin-Up','Rug','chinup','lats biceps','midback','Optrekstang',['Pak de stang onderhands op schouderbreedte.','Trek jezelf omhoog door de ellebogen naar beneden te bewegen.','Laat gecontroleerd terugzakken.'],'Vanuit de onderrug zwaaien.');
add('pushup','Push-Up','Borst','pushup','chest','triceps abs','Vloer',['Plaats handen iets breder dan schouders en span je buik aan.','Zak met een rechte romp tot je borst dicht bij de vloer is.','Duw jezelf weer omhoog.'],'Heupen laten zakken of ellebogen volledig naar buiten draaien.');
add('cable-fly','Cable Chest Fly','Borst','cableFly','chest','frontdelts','Kabelstation',['Zet de katrollen ongeveer op borsthoogte.','Maak met iets gebogen ellebogen een omhelzende beweging voor je borst.','Open je armen langzaam voor een gecontroleerde rek.'],'Met je schouders naar voren trekken.');
add('singlearm-row','Single-Arm Dumbbell Row','Rug','singleArmRow','lats midback','biceps','Dumbbell + bank',['Steun met één hand en knie op een stabiele bank.','Trek de dumbbell richting je heup.','Laat gecontroleerd zakken zonder je romp te draaien.'],'Gewicht omhoog rukken met de romp.');
add('cable-reverse-fly','Cable Reverse Fly','Schouders','cableReverseFly','reardelts','midback','Kabelstation',['Kruis de kabels en houd je armen licht gebogen.','Trek de armen naar buiten op schouderhoogte.','Keer beheerst terug.'],'Schouders optrekken.');
add('rdl','Romanian Deadlift','Benen','rdl','hamstrings glutes','lowerback','Halterstang of dumbbells',['Houd de gewichten dicht langs je benen.','Duw je heupen naar achteren met licht gebogen knieën en neutrale rug.','Strek je heupen om rechtop te komen.'],'Een ronde rug of de gewichten ver van het lichaam laten komen.');
add('lunge','Reverse Lunge','Benen','lunge','quads glutes','hamstrings','Dumbbells of lichaamsgewicht',['Stap gecontroleerd achteruit en zak omlaag.','Houd je romp stabiel; voorste voet volledig aan de grond.','Duw via je voorste voet weer omhoog.'],'Met je knie naar binnen vallen.');
add('hip-thrust','Hip Thrust','Benen','hipThrust','glutes','hamstrings','Bank + halterstang',['Plaats je bovenrug tegen een stevige bank.','Duw je heupen omhoog tot de romp ongeveer horizontaal ligt.','Span je billen aan en zak gecontroleerd.'],'Onderrug overstrekken in plaats van heupen strekken.');
add('goblet-squat','Goblet Squat','Benen','gobletSquat','quads glutes','abs','Dumbbell',['Houd één dumbbell voor je borst.','Zak tussen je heupen met je romp stabiel.','Kom omhoog door je voeten stevig in de grond te duwen.'],'Je hakken laten loskomen of naar voren omvallen.');
add('ab-wheel','Ab Wheel Rollout','Buik','abwheel','abs','shoulders','Ab-wheel',['Kniel en span je buik en billen aan.','Rol langzaam naar voren zolang je onderrug neutraal blijft.','Trek jezelf vanuit je romp terug.'],'Onderrug laten doorzakken.');
add('seated-calf','Seated Calf Raise','Benen','seatedCalf','calves','','Bank + gewicht',['Zit rechtop met voeten stevig op een verhoging.','Duw je hielen omhoog en span je kuiten aan.','Laat gecontroleerd terugzakken.'],'Snel veren of pijn negeren.');
