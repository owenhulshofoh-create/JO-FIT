oud ribben omlaag.","safety":"Niet overstrekken in de onderrug; plaats de voeten dichterbij of verder weg voor meer comfort."},"dead-bug":{"stability":"Ga op de rug liggen met heupen en knieën 90 graden en beide armen boven je borst.","feel":"Strek langzaam één arm en het tegenovergestelde been uit zonder dat de onderrug hol wordt.","safety":"Beweeg om en om; maak de uitslag kleiner als de rug de vloer loslaat."},"farmer-carry":{"stability":"Kies gewichten waarmee je stabiel kunt lopen; sta lang en kijk vooruit.","feel":"Loop rustig met gewichten naast je lichaam en romp actief; train grip en rompstabiliteit.","safety":"Niet slingeren of zijwaarts wegzakken; stop voordat je je grip verliest."}};
function getSpecificCoach(e){return COACH_SPECIFIC[e.id]||{focus:'De rood gemarkeerde spieren leveren het grootste aandeel bij deze oefening.',setup:e.steps[0]||'',action:e.steps[1]||'',control:e.steps[2]||'',progress:'Haal eerst alle geplande herhalingen met stabiele techniek; verhoog de weerstand daarna geleidelijk.'};}
function getExerciseProfile(e){const m=e.motion;let stimulus='Mechanische spanning';let feel='Volledige range met constante spanning';let best='1–2 reps vóór technisch falen';if(['benchPress','inclinePress','shoulderPress','squat','bentRow','rdl','pullup'].includes(m)){stimulus='Zware compound';feel='Strakke brace en herhaalbare baan';best='2–3 min rust, progressief belasten';}else if(['lateralRaise','facePull','reverseFly','pushdown','overheadExt','crossbody','curl','hammerCurl','inclineCurl','preacher','legExtension','hamstringCurl','calfRaise'].includes(m)){stimulus='Isolatie & pomp';feel='Licht tot middelzwaar, weinig momentum';best='Zoek spiergevoel en topspanning';}else if(['legRaise','cableCrunch','abwheel'].includes(m)){stimulus='Core-spanning';feel='Bekken controleren en niet zwaaien';best='Kwaliteit boven extra herhalingen';}
 return {stimulus,feel,best};}
function getPhaseData(pct){const ease=x=>.5-.5*Math.cos(Math.PI*x);if(pct<.12)return {t:0,label:'STARTPOSITIE',cue:'Zet jezelf vast, span je romp aan en bereid de doelspieren voor.'};if(pct<.46)return {t:ease((pct-.12)/.34),label:'CONCENTRISCH',cue:'Beweeg doelgericht door de actieve fase en laat de juiste spier het werk doen.'};if(pct<.60)return {t:1,label:'TOPPOSITIE',cue:'Knijp kort samen in de eindpositie zonder spanning te verliezen.'};if(pct<.95)return {t:1-ease((pct-.60)/.35),label:'EXCENTRISCH',cue:'Laat gecontroleerd terugzakken en houd spanning op de doelspier.'};return {t:0,label:'RESET',cue:'Herpak je houding en start de volgende herhaling even strak.'};}

function getDynamicCue(e,phase){const d=getSpecificCoach(e);if(phase.label==='STARTPOSITIE')return d.setup;if(phase.label==='CONCENTRISCH')return d.action;if(phase.label==='EXCENTRISCH')return d.control;if(phase.label==='TOPPOSITIE')return 'Houd kort controle en spanning op '+e.primary.map(labelMus).join(', ').toLowerCase()+'.';return 'Herstel je houding. Volgende herhaling zonder momentum.';}
